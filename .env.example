# Picode 环境配置模板
# 用法：cp .env.example .env，然后按需修改

# ── Core Daemon ───────────────────────────────────────────────
PICODE_HOST=127.0.0.1
PICODE_PORT=7437

# ── Logging ───────────────────────────────────────────────────
PICODE_LOG_LEVEL=INFO
# 留空则仅输出 stderr，不写文件
PICODE_LOG_FILE=~/.picode/logs/core.log
# text（人工可读键值对）或 json（结构化，适合日志聚合）
PICODE_LOG_FORMAT=text

# ── Config File ───────────────────────────────────────────────
# PICODE_CONFIG=~/.picode/config.toml

# ── LLM（S1 阶段启用）────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# PICODE_LLM_DEFAULT_MODEL=claude-sonnet-4-6
# PICODE_MAX_STEPS=20
